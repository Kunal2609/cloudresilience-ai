# CloudResilience AI Environment Configuration

PROJECT_NAME="CloudResilience AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (Defaults to SQLite for instant local zero-dependency launch)
DATABASE_URL=sqlite:///./cloudresilience.db
# For PostgreSQL via Docker Compose:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cloudresilience-local
POSTGRES_DB=cloudresilience
# DATABASE_URL=postgresql+psycopg://postgres:cloudresilience-local@localhost:5432/cloudresilience

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=resilience123

# Optional LLM API Key for Dynamic Narrative Generation
# When omitted, the platform uses its deterministic rule-based explainer.
OPENAI_API_KEY=
GEMINI_API_KEY=
